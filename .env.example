# Zerion API key (https://dashboard.zerion.io). Server-only — never prefix it with NEXT_PUBLIC_.
ZERION_API_KEY=

# true → every API route answers from src/shared/server/fixtures, no key or network needed.
USE_MOCKS=true

# Optional tuning (defaults shown). The demo tier allows 1 request/s and 300 requests/day.
# ZERION_CACHE_TTL_SECONDS=300
# ZERION_RPS=1
# ZERION_TIMEOUT_MS=20000

# Mock mode only: simulated latency and forced errors per route, e.g. chart:RATE_LIMITED,activity:UPSTREAM_ERROR
# MOCK_LATENCY_MS=500
# MOCK_FAIL=
